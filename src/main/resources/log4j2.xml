<?xml version="1.0" encoding="UTF-8"?>
<!--
  packages="com.mantimetrics.utility" lets Log4j2 discover the custom @Plugin
  ProgressBarLogAppender by scanning that package. status="ERROR" keeps Log4j2's own
  internal StatusLogger quiet (it hides the deprecation WARN about package scanning),
  so only real application logs are printed.
-->
<Configuration status="ERROR" packages="com.mantimetrics.utility">
    <Appenders>
        <!--
          ProgressBarLogAppender writes to System.out and holds ProgressBar.CONSOLE_LOCK
          around each log line, so log messages and progress bars never share a terminal line.
        -->
        <ProgressBarLogAppender name="Console">
            <PatternLayout disableAnsi="false">
                <!-- %highlight applies ANSI colors based on level -->
                <Pattern>%style{%d{HH:mm:ss}}{dim} %highlight{%-5level}{FATAL=bg_red, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan, TRACE=blue} %style{%class{1}}{cyan,bold} %style{-}{dim} %highlight{%msg}{FATAL=bg_red, ERROR=red, WARN=yellow, INFO=normal, DEBUG=normal, TRACE=normal}%n</Pattern>
            </PatternLayout>
        </ProgressBarLogAppender>
    </Appenders>

    <Loggers>
        <!-- 1) Turn JGit down to WARN (no DEBUG/TRACE) -->
        <Logger name="org.eclipse.jgit" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- 2) Silences all DEBUGs of Apache HttpClient -->
        <Logger name="org.apache.http" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="okhttp3" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- 3) Completely disable wire-logging (byte swapping) -->
        <Logger name="org.apache.http.wire" level="off" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- 4) Suppress noisy third-party loggers -->
        <Logger name="com.github.javaparser.ast.resolution.AsmSymbolResolver" level="off" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="net.sourceforge.pmd" level="off" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="edu.umd.cs.findbugs" level="off" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- default logger -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
